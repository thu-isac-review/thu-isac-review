{
  "hosting": {
    "site": "thu-intern",
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/gcis/company/**",
        "destination": "https://data.gcis.nat.gov.tw/od/data/api/5F64D864-61CB-4D0D-8AD9-492047CC10F8"
      },
      {
        "source": "/api/gcis/business/**",
        "destination": "https://data.gcis.nat.gov.tw/od/data/api/236EE382-4942-41A9-BD3A-169488B73E6E"
      }
    ]
  }
}
